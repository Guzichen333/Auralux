{
  "id": "hello-world",
  "name": "Hello World Extension",
  "version": "1.0.0",
  "description": "Auralux 插件系统测试",
  "author": "Auralux Team",
  "main": "extension.js",
  "module": "helloWorldExtension",
  "canDisable": true,
  "activationEvents": [
    "onStartUp"
  ],
  "permissions": [
    "ui.notification",
    "storage.read",
    "storage.write"
  ],
  "contributes": {
    "commands": [
      {
        "command": "helloWorld.sayHello",
        "title": "Hello World: Say Hello"
      }
    ]
  },
  "engines": {
    "musicbox": "^1.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hello",
    "world",
    "example"
  ]
}
